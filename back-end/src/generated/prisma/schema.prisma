generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(100)
  email      String      @unique @db.VarChar(100)
  password   String      @db.VarChar(100)
  phone      String?     @db.VarChar(20)
  role       Role        @default(CUSTOMER)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  addresses  addresses[]
  expenses   expenses[]
  feedbacks  feedbacks[]
  orders     orders[]
}

model products {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  description String?       @db.Text
  price       Decimal       @db.Decimal(12, 2)
  stock       Int
  category    String?       @db.VarChar(100)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  image_url   String?
  order_items order_items[]
}

model orders {
  id               Int            @id @default(autoincrement())
  customer_id      Int
  status           OrderStatus    @default(PENDING_PAYMENT)
  total_price      Decimal        @db.Decimal(12, 2)
  discount_amount  Decimal        @default(0.00) @db.Decimal(12, 2)
  order_date       DateTime       @default(now())
  shipping_address Json
  shipping_cost    Decimal        @db.Decimal(12, 2)
  shipping_method  String         @db.VarChar(100)
  sub_total        Decimal        @db.Decimal(12, 2)
  tracking_number  String?        @db.VarChar(100)
  voucher_id       Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  custom_order     custom_orders?
  feedbacks        feedbacks?
  order_items      order_items[]
  customer         users          @relation(fields: [customer_id], references: [id])
  voucher          vouchers?      @relation(fields: [voucher_id], references: [id])
  payment          payments?

  @@index([customer_id])
  @@index([voucher_id])
}

model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  order      orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    products @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}

model raw_materials {
  id            Int      @id @default(autoincrement())
  stock         Decimal  @db.Decimal(12, 2)
  reorder_level Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  material_id   Int      @unique // ✅ tambahkan ini agar valid untuk one-to-one

  material materials @relation(fields: [material_id], references: [id])
}

model materials {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(150)
  unit         UnitEnum
  barcode      String   @unique @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  defaultStock Decimal  @db.Decimal(12, 2)

  raw_material raw_materials? // one-to-one: materials → raw_materials
}

model addresses {
  id          Int     @id @default(autoincrement())
  user_id     Int
  label       String  @db.VarChar(100)
  recipient   String  @db.VarChar(100)
  phone       String  @db.VarChar(20)
  street      String  @db.Text
  city        String  @db.VarChar(100)
  province    String  @db.VarChar(100)
  postal_code String  @db.VarChar(10)
  is_default  Boolean @default(false)
  user        users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model vouchers {
  id             Int         @id @default(autoincrement())
  code           String      @unique @db.VarChar(50)
  description    String?     @db.Text
  discount_value Decimal     @db.Decimal(12, 2)
  discount_type  VoucherType
  max_discount   Decimal?    @db.Decimal(12, 2)
  min_purchase   Decimal     @default(0.00) @db.Decimal(12, 2)
  valid_until    DateTime
  usage_limit    Int
  created_at     DateTime    @default(now())
  current_usage  Int         @default(0)
  updated_at     DateTime    @updatedAt
  valid_from     DateTime    @default(now())
  orders         orders[]
}

model payments {
  id                     Int           @id @default(autoincrement())
  order_id               Int           @unique
  amount                 Decimal       @db.Decimal(12, 2)
  payment_method         String?       @db.VarChar(100)
  status                 PaymentStatus @default(PENDING)
  created_at             DateTime      @default(now())
  expires_at             DateTime
  gateway_transaction_id String?       @unique @db.VarChar(255)
  paid_at                DateTime?
  payment_code           String?       @db.Text
  payment_gateway        String        @default("midtrans") @db.VarChar(50)
  payment_url            String?       @db.Text
  updated_at             DateTime      @updatedAt
  bank                   String?       @db.VarChar(50)
  invoice                invoices?
  order                  orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model invoices {
  id             Int      @id @default(autoincrement())
  payment_id     Int      @unique
  generated_date DateTime @default(now())
  file_url       String   @db.VarChar(255)
  payment        payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)
}

model feedbacks {
  id           Int      @id @default(autoincrement())
  customer_id  Int
  order_id     Int      @unique
  message      String?  @db.Text
  rating       Int
  submitted_at DateTime @default(now())
  customer     users    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order        orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([order_id])
}

model expenses {
  id           Int       @id @default(autoincrement())
  expense_type String?   @db.VarChar(100)
  amount       Decimal?  @db.Decimal(10, 2)
  expense_date DateTime? @db.Date
  notes        String?   @db.Text
  user_id      Int?
  user         users?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model custom_orders {
  id                  Int       @id @default(autoincrement())
  order_id            Int?      @unique
  request_description String?   @db.Text
  due_date            DateTime? @db.Date
  notes               String?   @db.Text
  orders              orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum UnitEnum {
  gram
  kilogram
  pcs
  liter
  mililiter
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum VoucherType {
  PERCENTAGE
  FIXED
}
